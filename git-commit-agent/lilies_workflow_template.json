                "config": {
                    "tool_name": "Bash",
                    "input": {
                        "command": "if ! git rev-parse --git-dir >/dev/null 2>&1; then echo \"NO_CHANGES\"; exit 0; fi; STAGED=$(git diff --cached 2>/dev/null); UNSTAGED=$(git diff 2>/dev/null); if [ -z \"$STAGED\" ] && [ -z \"$UNSTAGED\" ]; then echo \"NO_CHANGES\"; else echo \"$STAGED\"; echo \"===UNSTAGED===\"; echo \"$UNSTAGED\"; fi",
                        "timeout": 60
                    }
                },
