ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ARG SANDBOX_UID=10001
ARG SANDBOX_GID=10001

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git jq ripgrep && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid ${SANDBOX_GID} agent 2>/dev/null || true && \
    useradd --create-home --uid ${SANDBOX_UID} --gid ${SANDBOX_GID} agent && \
    pip install --no-cache-dir pytest
USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
