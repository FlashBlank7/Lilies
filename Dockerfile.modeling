ARG MODELING_BASE=python:3.12-slim
FROM ${MODELING_BASE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements-modeling.txt /opt/modeling/requirements.txt
COPY requirements-modeling.lock /opt/modeling/requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: -r /opt/modeling/requirements.lock && pip check
COPY platform/backend/src/agent_platform/modeling_worker.py /opt/modeling/worker.py
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLBACKEND=Agg PYTHONUNBUFFERED=1
ENV NUMBA_CACHE_DIR=/tmp/numba-cache
WORKDIR /job
ENTRYPOINT ["python", "/opt/modeling/worker.py"]
