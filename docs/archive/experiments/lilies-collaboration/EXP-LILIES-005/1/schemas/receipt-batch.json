{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "budget_name", "account_name", "date_range", "receipts"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "budget_name": {"type": "string", "minLength": 1},
    "account_name": {"type": "string", "minLength": 1},
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "receipt_imported_id",
          "date",
          "amount_cents",
          "ledger_amount_cents",
          "merchant_raw",
          "merchant_normalized",
          "category_hint",
          "source_sha256"
        ],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "receipt_imported_id": {
            "type": "string",
            "pattern": "^receipt:[A-Za-z0-9._-]+$",
            "maxLength": 100
          },
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "amount_cents": {"type": "integer", "minimum": 1},
          "ledger_amount_cents": {"type": "integer", "maximum": -1},
          "merchant_raw": {"type": "string", "minLength": 1, "maxLength": 240},
          "merchant_normalized": {"type": "string", "minLength": 1, "maxLength": 240},
          "category_hint": {"type": "string", "minLength": 1, "maxLength": 120},
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
