# 复制成 .env 之后请 `chmod 600 .env`：这里面是付费密钥和访问令牌，
# 而 cp 出来的文件按 umask 是 0644——同机其他用户直接可读。
# 平台启动时会检查这一点并在日志里提醒（不会替你改，那是你的文件）。
DEEPSEEK_API_KEY=replace-me
API_TOKEN=change-me
# Hard provider-egress circuit breaker. Keep false while inspecting balances,
# queues, or historical usage. Enable only for an explicitly authorized run.
MODEL_EGRESS_ENABLED=true
WORKSPACE_ROOT=./workspaces
# API 在容器内运行时，设为宿主机上的 workspaces 绝对路径。
# WORKSPACE_HOST_ROOT=/absolute/path/to/workspaces
DATA_DIR=./data
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_GENERATOR_MODEL=deepseek-v4-pro
DEEPSEEK_RUNTIME_MODEL=deepseek-v4-flash
# 本地小模型端点（vLLM/SGLang/Ollama 的 OpenAI 兼容 /v1）。设了就注册 local/ 前缀，
# 模型名写作 local/<served-model-name>（如 local/Qwen/Qwen3.5-4B）。
# 回环地址（127.0.0.1/localhost）不受 MODEL_EGRESS_ENABLED 拦截：本地推理不是计费出口。
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:8001/v1
# LOCAL_MODEL_API_KEY=local
SANDBOX_IMAGE=agent-platform-sandbox:latest
SANDBOX_UID=10001
SANDBOX_GID=10001
