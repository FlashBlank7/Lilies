DEEPSEEK_API_KEY=replace-me
API_TOKEN=change-me
# Hard provider-egress circuit breaker. Keep false while inspecting balances,
# queues, or historical usage. Enable only for an explicitly authorized run.
MODEL_EGRESS_ENABLED=false
# Multi-provider support (optional — only DeepSeek is required)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
WORKSPACE_ROOT=./workspaces
# API 在容器内运行时，设为宿主机上的 workspaces 绝对路径。
# WORKSPACE_HOST_ROOT=/absolute/path/to/workspaces
DATA_DIR=./data
# Local discovery is enabled for the standalone sibling daemon, but discovery
# grants no authority: explicit one-time pairing is still required. All
# collaboration, autonomous dispatch, and provider egress gates remain off.
LILIES_LOCAL_AGENT_ENABLED=true
LILIES_LOCAL_DISCOVERY_FILE=~/.lilies/daemon.json
LILIES_COLLABORATION_ENABLED=false
# Required only when the temporary formal-task collaboration channel is
# explicitly enabled. Use distinct, randomly generated values (32+ chars).
# Never give the developer token to Studio or Customer Runtime.
LILIES_COLLABORATION_DEVELOPER_TOKEN=
LILIES_COLLABORATION_VERIFIER_TOKEN=
# Optional platform-owned secret used to derive stable formal hidden-seed identities.
LILIES_FORMAL_HIDDEN_SEED_KEY=
# Reusable software collaboration is a separate, opt-in surface. The signing
# key is required only when enabled and must be a distinct random 32+ byte
# value. Autonomous dispatch remains independently disabled by default.
LILIES_COLLABORATIVE_DEVELOPMENT_ENABLED=false
LILIES_COLLABORATIVE_DEVELOPMENT_SIGNING_KEY=
LILIES_AUTONOMOUS_COLLABORATION_ENABLED=false
LILIES_LOCAL_BUILDER_DEFAULT=false
# Optional override for the platform URL used inside BuildAssignment.
# scripts/dev_platform.sh otherwise derives it from the actual API host/port.
# LILIES_PLATFORM_BASE_URL=http://127.0.0.1:8001
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_GENERATOR_MODEL=deepseek-v4-pro
DEEPSEEK_RUNTIME_MODEL=deepseek-v4-flash
SANDBOX_IMAGE=agent-platform-sandbox:latest
SANDBOX_UID=10001
SANDBOX_GID=10001
