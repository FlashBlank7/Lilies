<?xml version="1.0"?>
<!--
  Tasker 配置文件 — 导入到 Tasker 即可使用
  使用方法: Tasker → 长按"配置文件"标签 → 导入 → 选择此文件
-->
<TaskerData version="1.0">
  <!-- 上班打卡 8:45 -->
  <Profile sr="prof1" ve="2">
    <cdate>0</cdate>
    <edate>0</edate>
    <flags>0</flags>
    <id>1</id>
    <limit>true</limit>
    <mid>0</mid>
    <nme>钉钉上班打卡 8:45</nme>
    <Time sr="con0" ve="2">
      <fh>8</fh><fm>45</fm><th>8</th><tm>46</tm>
    </Time>
    <Day sr="con1" ve="2">
      <wday>12345</wday>  <!-- 周一至周五 -->
    </Day>
  </Profile>

  <Task sr="task1" ve="2">
    <cdate>0</cdate>
    <edate>0</edate>
    <id>1</id>
    <nme>执行打卡</nme>
    <Action sr="act0" ve="7">
      <code>523</code>  <!-- 发送通知 -->
      <Str sr="arg0" ve="3">钉钉打卡</Str>
      <Str sr="arg1" ve="3">⏰ 上班打卡时间到！正在打开钉钉...</Str>
      <Int sr="arg2" val="0"/>
    </Action>
    <Action sr="act1" ve="7">
      <code>20</code>  <!-- 启动App -->
      <Str sr="arg0" ve="3">com.alibaba.android.rimet</Str>  <!-- 钉钉 -->
      <Str sr="arg1" ve="3"/>
      <Int sr="arg2" val="0"/>
    </Action>
    <Action sr="act2" ve="7">
      <code>131</code>  <!-- 等待 -->
      <Int sr="arg0" val="5"/>  <!-- 等5秒App启动 -->
    </Action>
    <Action sr="act3" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">钉钉打卡</Str>
      <Str sr="arg1" ve="3">请手动点击考勤打卡按钮 ✅</Str>
    </Action>
  </Task>

  <!-- 下班签退 19:00 -->
  <Profile sr="prof2" ve="2">
    <cdate>0</cdate><edate>0</edate>
    <id>2</id>
    <nme>钉钉下班签退 19:00</nme>
    <Time sr="con0" ve="2">
      <fh>19</fh><fm>0</fm><th>19</th><tm>1</tm>
    </Time>
    <Day sr="con1" ve="2">
      <wday>12345</wday>
    </Day>
  </Profile>
</TaskerData>
